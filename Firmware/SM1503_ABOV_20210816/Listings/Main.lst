 627   5                                              if(MotoGear == GEAR_P)
 628   5                                                      Pid.SetPoint = 5;               //10    
 629   5                                              else
 630   5                                                      Pid.SetPoint = 2;                       //2     
 631   5                                              PidInit();
 632   5                                              SET_SCR_ON(MotoRunFlag);
 633   5                                              OS_Request_Task(TaskMoto);
 634   5                                              SET_LED(LED_ON);
 635   5                                              ReturnZero = 0;
 636   5                                      }
 637   4                                      else if(MotoRunFlag == 0)
 638   4                                              SET_LED(LED_FLASH);
 639   4                              }
 640   3                      }
 641   2              }
 642   1      }
 643          
 644          //设置档位灯
 645          void Led_Task(void)
 646          {
 647   1              OS_Wait_Timer(10);  //10ms
 648   1              switch(LedMode)
 649   1              {
 650   2                      case LED_ON:
 651   2                      case LED_OFF:
 652   2                              Led_Pwm = LedMode?1:0;
 653   2                              LedFlashCnt = 0;
 654   2                              LedMode = 0xff;
 655   2                              break;
 656   2                      case LED_FLASH:
 657   2                              if(LedFlashCnt)
 658   2                                      LedFlashCnt--;
 659   2                              else
 660   2                              {
 661   3                                      Led_Pwm = ~Led_Pwm;
 662   3                                      LedFlashCnt =LED_FLASH_CNT;
 663   3                              }
 664   2                              break;
 665   2              }
 666   1      }
